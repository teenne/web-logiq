---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Last ned Logicmath" description="Last ned Logicmath og start med en gratis diagnostikk. Finn hullene dine i matte og få tilpasset øving.">
  <Header />
  <main id="main-content">
    <section class="flex min-h-[60vh] items-center px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="font-heading text-4xl font-bold text-primary-900 dark:text-white md:text-5xl">Last ned Logicmath</h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-primary-600 dark:text-primary-400">Velg mattefaget ditt og kom i gang med en gratis diagnostikk. Finn hullene, og start med tilpasset øving.</p>

        <div class="mt-10">
          <a href="/velg-plan?fag=2p" class="inline-flex items-center rounded-lg bg-accent-500 px-8 py-4 text-lg font-semibold text-white transition-colors hover:bg-accent-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500">
            Velg mattefag og plan
          </a>
        </div>

        <div class="mx-auto mt-12 grid max-w-lg gap-6 sm:grid-cols-3">
          <div class="text-center">
            <p class="font-heading text-3xl font-bold text-primary-900 dark:text-white">543+</p>
            <p class="mt-1 text-sm text-primary-500">oppgaver</p>
          </div>
          <div class="text-center">
            <p class="font-heading text-3xl font-bold text-primary-900 dark:text-white">5 min</p>
            <p class="mt-1 text-sm text-primary-500">diagnostikk</p>
          </div>
          <div class="text-center">
            <p class="font-heading text-3xl font-bold text-primary-900 dark:text-white">0 kr</p>
            <p class="mt-1 text-sm text-primary-500">for å prøve</p>
          </div>
        </div>

        <div class="mt-12 rounded-xl border border-primary-200 bg-primary-50 p-6 text-left dark:border-primary-700 dark:bg-primary-900/20">
          <h2 class="font-heading text-lg font-semibold text-primary-900 dark:text-white">Hva du får gratis</h2>
          <ul class="mt-3 space-y-2 text-sm text-primary-600 dark:text-primary-400">
            <li class="flex items-start gap-2"><span class="mt-0.5 shrink-0 text-green-600 font-bold">&#10003;</span>Diagnostikk for 1 emne</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 shrink-0 text-green-600 font-bold">&#10003;</span>Se dine kunnskapshull</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 shrink-0 text-green-600 font-bold">&#10003;</span>5 veiledet øvingsoppgaver</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 shrink-0 text-green-600 font-bold">&#10003;</span>Tilgang til AI-mentor</li>
          </ul>
        </div>

        <p class="mt-8 text-sm text-primary-500 dark:text-primary-400">Tilgjengelig for Matematikk 2P. Flere fag kommer basert på etterspørsel.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
