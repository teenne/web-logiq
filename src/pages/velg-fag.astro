---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const mattefag = [
  {
    level: 'Barneskolen',
    subjects: [
      { name: 'Matematikk 1.-4. trinn', desc: 'Tallforståelse, addisjon, subtraksjon, enkel geometri', slug: 'matte-1-4' },
      { name: 'Matematikk 5.-7. trinn', desc: 'Brøk, desimaltall, prosent, areal og omkrets', slug: 'matte-5-7' },
    ],
  },
  {
    level: 'Ungdomsskolen',
    subjects: [
      { name: 'Matematikk 8. trinn', desc: 'Algebra, likninger, negative tall, koordinatsystem', slug: 'matte-8' },
      { name: 'Matematikk 9. trinn', desc: 'Funksjoner, lineære likninger, sannsynlighet', slug: 'matte-9' },
      { name: 'Matematikk 10. trinn', desc: 'Andregradsfunksjoner, trigonometri, statistikk', slug: 'matte-10' },
    ],
  },
  {
    level: 'Videregående',
    subjects: [
      { name: '1P', desc: 'Praktisk matematikk: økonomi, prosent, statistikk', slug: '1p' },
      { name: '1T', desc: 'Teoretisk matematikk: algebra, funksjoner, geometri', slug: '1t' },
      { name: '2P', desc: 'Funksjoner, statistikk, sannsynlighet, modellering', slug: '2p' },
      { name: 'S1', desc: 'Sannsynlighet, kombinatorikk, funksjonsanalyse', slug: 's1' },
      { name: 'S2', desc: 'Integrasjon, differensiallikninger, statistisk modellering', slug: 's2' },
      { name: 'R1', desc: 'Avansert algebra, derivasjon, vektorer', slug: 'r1' },
      { name: 'R2', desc: 'Integrasjon, differensiallikninger, romgeometri', slug: 'r2' },
    ],
  },
];
---
<BaseLayout title="Velg mattefag | Logicmath" description="Velg mattefaget du sliter med, så finner vi riktig plan for deg.">
  <Header />
  <main id="main-content">
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="text-center">
          <h1 class="font-heading text-4xl font-bold text-primary-900 dark:text-white md:text-5xl">Hvilket mattefag trenger du hjelp med?</h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-600 dark:text-primary-400">Velg faget ditt, så viser vi planer og priser tilpasset deg.</p>
        </div>
        <div class="mt-12 space-y-10">
          {mattefag.map((group) => (
            <div>
              <h2 class="font-heading text-lg font-semibold text-primary-700 dark:text-primary-300">{group.level}</h2>
              <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {group.subjects.map((subject) => (
                  <a href={`/velg-plan?fag=${subject.slug}`} class="block rounded-xl border border-primary-200 p-5 transition-all hover:border-accent-500 hover:shadow-md dark:border-primary-700 dark:hover:border-accent-500" data-track="subject_click" data-label={subject.slug}>
                    <h3 class="font-heading font-semibold text-primary-900 dark:text-white">{subject.name}</h3>
                    <p class="mt-1 text-sm text-primary-600 dark:text-primary-400">{subject.desc}</p>
                    <p class="mt-3 text-xs font-semibold text-accent-600">Velg plan →</p>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
