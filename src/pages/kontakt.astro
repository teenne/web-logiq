---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromUrl, t } from '../i18n/translations';
const locale = getLocaleFromUrl(Astro.url);

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Halisonworks AS',
  url: 'https://logiq.halisonworks.com',
  email: 'hello@halisonworks.com',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'NO',
  },
};
---

<BaseLayout
  title={t(locale, 'contactPage.title')}
  description="Har du spørsmål om Logicmath? Send oss en melding, så svarer vi så raskt vi kan."
  jsonLd={organizationJsonLd}
>
  <Header />

  <main id="main-content">
    <section class="bg-primary-50 px-4 py-16 dark:bg-primary-900/20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="font-heading text-4xl font-bold text-primary-900 dark:text-white md:text-5xl">
          {t(locale, 'contactPage.heading')}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-600 dark:text-primary-400">
          {t(locale, 'contactPage.intro')}
        </p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <ContactForm showCompanyField={false} />
        </div>

        <div class="lg:col-span-2">
          <div class="rounded-2xl bg-primary-50 p-8 dark:bg-primary-900">
            <h2 class="font-heading text-xl font-bold text-primary-900 dark:text-white">
              {t(locale, 'contactPage.infoTitle')}
            </h2>
            <p class="mt-2 text-sm text-primary-500 dark:text-primary-400">
              {t(locale, 'contactPage.infoIntro')}
            </p>

            <ul class="mt-8 space-y-6" role="list">
              <li class="flex items-start gap-4">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <div>
                  <span class="block text-sm font-semibold text-primary-900 dark:text-white">{t(locale, 'contactPage.email')}</span>
                  <a
                    href="mailto:hello@halisonworks.com"
                    class="mt-1 block text-sm text-primary-500 transition-colors hover:text-accent-500 dark:text-primary-400"
                  >
                    hello@halisonworks.com
                  </a>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <div>
                  <span class="block text-sm font-semibold text-primary-900 dark:text-white">{t(locale, 'contactPage.address')}</span>
                  <span class="mt-1 block text-sm text-primary-500 dark:text-primary-400">
                    Halisonworks AS<br />
                    Norge
                  </span>
                </div>
              </li>
            </ul>

            <div class="mt-8 rounded-lg border border-primary-200 bg-white p-4 dark:border-primary-700 dark:bg-primary-800">
              <p class="text-sm text-primary-600 dark:text-primary-400">
                <strong>Logicmath</strong> er utviklet av Halisonworks AS. Vi svarer vanligvis innen en virkedag.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
